name: Build

on:
  workflow_dispatch:
  push:

jobs:
  build:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - uses: microsoft/setup-msbuild@v2
      - name: Build
        run: msbuild "Miitopia Save Editor Switch Version.sln" /p:Configuration=Release /restore
      - uses: actions/upload-artifact@v4
        with:
          name: Miitopia-Save-Editor
          path: "Miitopia Save Editor Switch Version/bin/Release/"
